# Copy to .env (never commit .env). All variables use the COMPASS_ prefix.
COMPASS_ENVIRONMENT=development
COMPASS_DATABASE_URL=postgresql+psycopg://compass:compass@localhost:5432/compass
COMPASS_REDIS_URL=redis://localhost:6379/0
# Required for authentication, >= 32 chars:  python -c "import secrets; print(secrets.token_urlsafe(48))"
COMPASS_AUTH_SECRET=
# Sessions (docs/AUTHENTICATION.md). Sign a client in with:  python -m app.cli issue-pairing-code --github-id <id> --username <name>
COMPASS_AUTH_ACCESS_TTL_SECONDS=900        # access token lifetime (>= 5)
COMPASS_AUTH_REFRESH_TTL_HOURS=168         # refresh token lifetime, renewed on every rotation
COMPASS_AUTH_SESSION_MAX_DAYS=30           # absolute session lifetime
COMPASS_AUTH_PAIRING_TTL_MINUTES=10        # pairing code lifetime
# "Keep me signed in" sessions (refresh token kept on disk by the client) get tighter limits; they can never exceed the general ones.
COMPASS_AUTH_PERSISTENT_REFRESH_TTL_HOURS=72
COMPASS_AUTH_PERSISTENT_SESSION_MAX_DAYS=14
# Rate limiting of /auth/exchange, /auth/refresh, /auth/logout. IN-MEMORY and PER PROCESS (docs/AUTHENTICATION.md section 7).
COMPASS_AUTH_RATE_LIMIT_ENABLED=true
# memory = per process (default); database = shared by all workers/instances (recommended when more than one process serves requests)
COMPASS_AUTH_RATE_LIMIT_BACKEND=memory
COMPASS_AUTH_ATTEMPTS_PER_MINUTE=20
COMPASS_AUTH_MAX_FAILURES=5
COMPASS_AUTH_FAILURE_WINDOW_SECONDS=900
COMPASS_AUTH_GLOBAL_ATTEMPTS_PER_MINUTE=600
# Number of TRUSTED reverse proxies in front of the API (0 = ignore X-Forwarded-For, which clients can forge).
COMPASS_TRUSTED_PROXY_HOPS=0
# Per-request budgets and cancel-on-disconnect (docs/REQUEST_CANCELLATION.md). Keep below the extension's 30 s / 90 s timeouts.
COMPASS_REQUEST_CANCELLATION_ENABLED=true
COMPASS_REQUEST_DEADLINE_SECONDS=25
COMPASS_SLOW_REQUEST_DEADLINE_SECONDS=60
# Legacy `issue-token` tokens (12 h, NOT revocable). Always refused when COMPASS_ENVIRONMENT=production.
COMPASS_AUTH_ALLOW_LEGACY_TOKENS=true
COMPASS_AUTH_TOKEN_TTL_MINUTES=720         # legacy tokens only

# GitHub API (optional). Unauthenticated = 60 req/h; with a token 5000 req/h.
# Use a fine-grained token with NO scopes/permissions beyond public read. Never commit it.
COMPASS_GITHUB_TOKEN=
COMPASS_GITHUB_TIMEOUT_SECONDS=10
COMPASS_GITHUB_MAX_RETRIES=3
# Keep low for the API process: waits longer than this return HTTP 429 immediately.
COMPASS_GITHUB_MAX_RATE_LIMIT_WAIT_SECONDS=5
COMPASS_GITHUB_SYNC_TTL_SECONDS=900
COMPASS_GITHUB_MIN_REFRESH_SECONDS=30
COMPASS_GITHUB_ISSUE_SYNC_MAX_PAGES=3

# Optional ML difficulty model (see docs/ML.md). Leave empty to disable.
COMPASS_ML_DIFFICULTY_MODEL_DIR=
